# ---------------------------------------------------------------------------
# RAG Application - Environment Configuration
# Copy this file to .env and fill in real values before running
# `docker compose up --build`.
# ---------------------------------------------------------------------------

# --- LLM Provider ---
# One of: ollama | gemini | openai | mock
# Ollama uses your local model with no API keys or tokens.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Service URLs (internal Docker network - leave as-is for Compose) ---
QDRANT_URL=http://qdrant:6333
EMBEDDING_SERVER_URL=http://embedding-server:8001
INDEXING_SERVER_URL=http://indexing-service:8002

# --- Ports exposed on the host ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
EMBEDDING_SERVER_PORT=8001
INDEXING_SERVER_PORT=8002
QDRANT_PORT=6333

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Hybrid search weighting (must sum to 1.0 for normalized scoring) ---
HYBRID_SEMANTIC_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4
SEARCH_TOP_K=5

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend build-time variable (must point to a host-reachable backend URL) ---
VITE_BACKEND_URL=http://localhost:8000
